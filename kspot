#!/bin/sh
# Health check + self-heal: ensures the watchdog is up (it, in turn, keeps the runner up).
# Never revives after a confirmed PASS/BUST (HALTED file).
cd "$(dirname "$0")" || exit 1

runners=$(pgrep -fc "^node runner\.mjs")
watchdogs=$(pgrep -fc "^(/bin/)?sh (\./)?watchdog\.sh$")
echo "runner: $runners  watchdog: $watchdogs"

if [ -f HALTED ]; then
  echo "HALTED: $(cat HALTED) — not reviving. Delete HALTED to resume."
  exit 0
fi

if [ "$watchdogs" -eq 0 ]; then
  echo "Reviving watchdog..."
  setsid nohup sh watchdog.sh >/dev/null 2>>watchdog.err < /dev/null &
  sleep 5
  echo "runner now: $(pgrep -fc "^node runner\.mjs")  watchdog now: $(pgrep -fc "^(/bin/)?sh (\./)?watchdog\.sh$")"
fi
